# Local BSC Mainnet settings. Never put wallet private keys or seed phrases here.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
# Shared anonymous discovery avoids running a full local market scanner.
DISTRICT9_MARKET_BASE_URL=https://district9.club
BSC_DISPLAY_RPC_URL=https://bsc-rpc.publicnode.com
BSC_SIGNAL_RPC_URL=https://bsc-rpc.publicnode.com
# Keep the initial live switch off. Enable personally after pairing your wallet.
ENABLE_LIVE_TRADING=false
LIVE_EXECUTION_ALLOWED=true
